# Скопируйте в .env и заполните. Файл .env НЕ коммитится.

# База данных (локально — контейнер из docker-compose на порту 5433)
DATABASE_URL=postgres://attache:attache_dev_password@localhost:5433/attache
POSTGRES_USER=attache
POSTGRES_PASSWORD=attache_dev_password
POSTGRES_DB=attache

# ИИ-ассистент «Атташе». Ключи хранятся ТОЛЬКО на сервере. Без ключей ассистент работает в офлайн-режиме.
# Провайдер: bedrock (DeepSeek V3.2 в Amazon Bedrock) | deepseek (прямой API DeepSeek)
AI_PROVIDER=bedrock

# Amazon Bedrock — заполните ОДИН из вариантов:
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=deepseek.v3.2
#   Вариант А: API-ключ Bedrock (обычно начинается с ABSK…)
AWS_BEARER_TOKEN_BEDROCK=
#   Вариант Б: ключи IAM-пользователя (AKIA… + секрет)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Прямой API DeepSeek (если AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Показывать на странице входа блок «Тестовые аккаунты для жюри»
DEMO_MODE=true

# Secure-флаг cookie: auto (по протоколу запроса) | true | false
COOKIE_SECURE=auto

# Web Push (уведомления на телефон). Без ключей push выключен, остальное работает.
# Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@mgimo-hub.local

# Публичный домен для HTTPS через Caddy (docker-compose.https.yml), например 34-88-153-35.sslip.io
DOMAIN=
